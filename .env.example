# === Roméo Bot — configuration ===
# Copie ce fichier en ".env" et remplis les valeurs.

# Token du bot Telegram — obtenu via @BotFather sur Telegram (commande /newbot)
TELEGRAM_BOT_TOKEN=

# Clé API Ticketmaster Discovery (le "Consumer Key")
# Crée un compte + une app sur https://developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Pays ciblé (code ISO). LAISSE VIDE = recherche mondiale, c'est le réglage utile :
# l'API Ticketmaster ne couvre quasiment pas la France (pour la FR, voir le relais email).
TM_COUNTRY_CODE=

# Intervalle de veille, en minutes (par défaut 10).
POLL_INTERVAL_MINUTES=10

# Fenêtre "ouverture imminente", en heures : on t'alerte ce délai AVANT l'ouverture des ventes.
ONSALE_SOON_HOURS=24

# Restriction d'accès : IDs Telegram autorisés, séparés par une virgule (ex : 12345,67890).
# Récupère l'ID en envoyant /whoami au bot. Vide = ouvert à tout le monde.
ALLOWED_CHAT_IDS=

# ── Veille email (optionnelle) : relaie les alertes billetterie reçues par mail ──
# Laisse vide pour désactiver. Recommandé : une adresse DÉDIÉE + mot de passe d'application.
# Gmail : IMAP_HOST=imap.gmail.com, IMAP_PASSWORD = mot de passe d'application (pas le tien).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
EMAIL_POLL_SECONDS=60
